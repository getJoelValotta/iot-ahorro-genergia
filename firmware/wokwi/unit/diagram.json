{
  "version": 1,
  "author": "Grupo 1 - TP Final IoT",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-led", "id": "led_online", "top": -100, "left": 180, "attrs": { "color": "green", "label": "ONLINE" } },
    { "type": "wokwi-resistor", "id": "r1", "top": -20, "left": 180, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-buzzer", "id": "bz1", "top": -110, "left": 260, "attrs": { "volume": "0.1" } },
    { "type": "wokwi-pushbutton", "id": "btn_find", "top": 200, "left": 180, "attrs": { "color": "blue", "label": "FIND_ME 10s" } },
    { "type": "wokwi-pushbutton", "id": "btn_mode", "top": 260, "left": 180, "attrs": { "color": "yellow", "label": "AHORRO/NORMAL" } }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],
    [ "led_online:A", "r1:1", "green", [] ],
    [ "r1:2", "esp:D2", "green", [] ],
    [ "led_online:C", "esp:GND.1", "black", [] ],
    [ "bz1:2", "esp:D25", "orange", [] ],
    [ "bz1:1", "esp:GND.1", "black", [] ],
    [ "btn_find:1.l", "esp:D4", "blue", [] ],
    [ "btn_find:2.l", "esp:GND.2", "black", [] ],
    [ "btn_mode:1.l", "esp:D15", "gold", [] ],
    [ "btn_mode:2.l", "esp:GND.2", "black", [] ]
  ],
  "serialMonitor": { "display": "auto" },
  "dependencies": {}
}
