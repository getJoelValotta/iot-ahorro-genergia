# Frontend Next.js — PLANTILLA SIN VALORES SECRETOS (docs/06 §6). Copiar a frontend/.env.local.
# Acá NUNCA va el clientSecret de Ovenbird ni el token del backend.

# URL del backend (incluye /api/v1). Para probar con el backend de otro grupo, cambiar SOLO
# esta variable y reiniciar `npm run dev` (el servidor de Next la lee en tiempo de ejecución).
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Opcional: pisa a NEXT_PUBLIC_API_URL solo en el servidor (útil en Vercel sin recompilar).
API_URL=

# Plataforma Ovenbird (el mapa la llama directo con el token de solo lectura del backend)
NEXT_PUBLIC_OVENBIRD_URL=https://iotplatform.ovenbirdconsulting.com.ar

# Opcional: forzar el atributo Secure de la cookie de sesión (por defecto: solo en producción).
# Poner COOKIE_SECURE=false para una demo con `next start` por http://<IP-del-aula>:3000.
COOKIE_SECURE=
