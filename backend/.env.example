# Backend NestJS — PLANTILLA SIN VALORES (docs/06 §6). Copiar a backend/.env (ignorado por git).
# Los secretos nunca van al repo, a los logs ni al frontend.

# Puerto local (el 3000 es del front Next.js)
PORT=3001

# JWT propio del backend. Generar uno largo (≥ 32 caracteres):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Duración del token en segundos
JWT_EXPIRES_IN_S=3600

# Supabase. Local: `supabase start` (ver supabase/README.md) muestra la URL y la "service_role key".
# Nube: Project Settings → API. SOLO backend: saltea Row Level Security.
SUPABASE_URL=http://127.0.0.1:54331
SUPABASE_SERVICE_ROLE_KEY=

# Ovenbird IoT Cloud (credenciales del proyecto; el secret se muestra una sola vez al crearlo)
OVENBIRD_URL=https://iotplatform.ovenbirdconsulting.com.ar
OVENBIRD_CLIENT_ID=
OVENBIRD_CLIENT_SECRET=

# Duración por defecto del token del mapa (máx. 3600)
EMBED_TOKEN_TTL_S=900

# Variante power-saving: capacidad SUPUESTA de la batería del collar (no conocemos la real)
BATTERY_CAPACITY_MAH=1000
# report_interval_s que se envía en cada modo (el collar pasa a ahorro desde 100 s)
POWER_NORMAL_INTERVAL_S=15
POWER_SAVING_INTERVAL_S=150
