# Secretos de la nube (Supabase + Vercel) — PLANTILLA SIN VALORES.
# Copiar a `.env` en la raíz (ignorado por git) y completar ahí:   cp .env.example .env
# Los valores reales nunca van al repo, al chat ni al frontend. Ver docs/06 §6.

# ---------------------------------------------------------------------------
# Supabase (panel del proyecto iot-mascotas-g1)
# ---------------------------------------------------------------------------
# Project Settings → General → "Project ID" (también es el subdominio de la URL)
SUPABASE_PROJECT_REF=
# Project Settings → API → "Project URL"  (https://<ref>.supabase.co)
SUPABASE_URL=
# Project Settings → API Keys → clave "service_role" (o "secret", sb_secret_...).
# SOLO para el backend: saltea Row Level Security. Nunca en el front ni en NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
# La contraseña que se eligió al crear el proyecto (la pide `supabase link` / `supabase db push`)
SUPABASE_DB_PASSWORD=
# Cuenta → Access Tokens (https://supabase.com/dashboard/account/tokens). Para la CLI/CI.
SUPABASE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Vercel (dos proyectos del mismo repo: backend/ y frontend/)
# ---------------------------------------------------------------------------
# Token de proyecto (vcp_..., solo sirve para ese proyecto) o de cuenta. Solo para CLI/CI (el deploy por Git no lo usa).
VERCEL_TOKEN=
# Team Settings → General → "Team ID" (o `vercel link` → .vercel/project.json → orgId)
VERCEL_ORG_ID=
# Project Settings → General → "Project ID" de cada proyecto
VERCEL_PROJECT_ID_BACKEND=
VERCEL_PROJECT_ID_FRONTEND=
# URLs públicas una vez desplegados (no son secretas, pero se usan para cargar variables y orígenes)
VERCEL_BACKEND_URL=
VERCEL_FRONTEND_URL=

# ---------------------------------------------------------------------------
# Backend (se cargan en el proyecto Vercel del back; mismas claves que backend/.env)
# ---------------------------------------------------------------------------
# Generar uno largo y aleatorio:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
OVENBIRD_URL=https://iotplatform.ovenbirdconsulting.com.ar
OVENBIRD_CLIENT_ID=
OVENBIRD_CLIENT_SECRET=
